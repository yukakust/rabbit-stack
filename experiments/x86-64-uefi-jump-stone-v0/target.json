{
  "schema_version": 1,
  "target_id": "x86-64-uefi-jump-stone-usb-v0",
  "architecture": "x86-64",
  "firmware": "uefi",
  "executable_format": "pe32-plus-efi-application",
  "media": {
    "layout": "mbr-fat32",
    "size_bytes": 67108864,
    "partition_start_lba": 2048,
    "default_boot_path": "EFI/BOOT/BOOTX64.EFI"
  },
  "capability_bindings": {
    "display.scene": "uefi-gop-linear-framebuffer",
    "input.keys": "uefi-simple-text-input",
    "time.delay": "uefi-boot-services-stall",
    "machine.exit": "return-efi-success"
  },
  "input_mapping": {
    "up": {"scan_code": 1},
    "down": {"scan_code": 2},
    "right": {"scan_code": 3},
    "left": {"scan_code": 4},
    "escape": {"scan_code": 23},
    "jump": {"unicode": 32},
    "leave_stone": {"unicode": [90, 122]}
  },
  "graphics_policy": {
    "minimum_width": 164,
    "minimum_height": 164,
    "bytes_per_pixel": 4,
    "accepted_pixel_formats": [
      "PixelRedGreenBlueReserved8BitPerColor",
      "PixelBlueGreenRedReserved8BitPerColor"
    ]
  },
  "boot_policy": {"secure_boot": "disabled", "signed": false},
  "installation_policy": {
    "removable_media_only": true,
    "internal_storage_writes": false,
    "firmware_writes": false,
    "recovery": "power-off-and-remove-usb"
  }
}
