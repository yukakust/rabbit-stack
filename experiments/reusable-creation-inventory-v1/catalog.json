      "version": "1.0.0",
      "kind": "anima",
      "name": "Bouncing Ball",
      "summary": "Moves one bounded ball from ticks, forces, and collision events.",
      "creator": {"id": "creator.yuka", "display_name": "Yuka"},
      "license": {"spdx": "MIT"},
      "interfaces": {
        "inputs": [
          {"name": "collisions", "type": "physics.collision-event"},
          {"name": "tick", "type": "time.tick"}
        ],
        "outputs": [{"name": "force", "type": "physics.force"}]
      },
      "dependencies": [
        {"component_id": "rabbit.capability.clock-tick", "version": "1.0.0"},
        {"component_id": "rabbit.capability.collision-circle", "version": "1.0.0"},
        {"component_id": "rabbit.capability.physics-2d", "version": "1.0.0"}
      ],
      "provides": ["behavior.bouncing-ball"],
      "authorities": [],
      "resources": {"memory_bytes": 1024, "persistent_bytes": 64, "objects": 1, "pixels_per_frame": 0, "ticks_per_second": 30},
      "implementation": {
        "format": "rabbit.state-machine.v1",
        "initial_state": "rolling",
        "states": ["rolling"],
        "transitions": ["collision:reflect-velocity", "tick:integrate"]
      }
    },
