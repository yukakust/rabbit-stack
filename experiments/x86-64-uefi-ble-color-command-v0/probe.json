{
  "schema_version": 1,
  "probe_id": "x86-64-uefi-ble-color-command-v0",
  "implementation_revision": 1,
  "target_usb_id": "0CF3:E009",
  "required_rom_version": "0x00000302",
  "commands": {
    "blue": "52414242-4954-4C45-8000-000000000002",
    "yellow": "52414242-4954-4C45-8000-000000000003"
  },
  "display": {
    "initial_color": "yellow",
    "shape": "centered-128x128-square",
    "accepted_pixel_formats": ["PixelRedGreenBlueReserved8BitPerColor", "PixelBlueGreenRedReserved8BitPerColor"]
  },
  "operations": [
    "initialize-exact-qca-controller-ram-from-hash-pinned-inputs",
    "issue-one-post-load-hci-reset-and-wait-100ms",
    "bind-current-gop-framebuffer",
    "draw-initial-yellow-square",
    "configure-bounded-passive-scan",
    "apply-only-exact-blue-or-yellow-command",
    "disable-passive-scan"
  ],
  "limits": {
    "max_usb_interfaces_per_phase": 64,
    "max_hci_commands": 6,
    "max_command_events": 8,
    "max_scan_events": 600,
    "event_timeout_ms": 200,
    "max_scan_duration_ms": 120000,
    "max_event_bytes": 80,
    "framebuffer_writes_per_command": 16384
  },
  "forbidden_operations": [
    "controller-flash-write",
    "active-scan",
    "advertise",
    "pair",
    "connect",
    "acl-data",
    "radio-transmit",
    "internal-storage-write",
    "firmware-setting-write",
    "arbitrary-code-command"
  ],
  "contract": "one-boot-two-command-passive-ble-color-runtime"
}
