{
  "schema_version": 1,
  "probe_id": "x86-64-usb-bluetooth-local-capabilities-v0",
  "implementation_revision": 1,
  "target_usb_id": "0CF3:E009",
  "operations": [
    "find-exact-usb-device-and-interface-00",
    "find-bounded-interrupt-in-endpoint",
    "send-hci-read-local-supported-commands-0x1002",
    "send-hci-read-local-supported-features-0x1003",
    "send-hci-le-read-local-supported-features-0x2003",
    "receive-bounded-command-complete-events",
    "display-local-controller-capabilities"
  ],
  "limits": {
    "max_usb_interfaces": 64,
    "max_endpoints_per_interface": 8,
    "max_hci_commands": 3,
    "max_hci_events_per_command": 8,
    "max_event_bytes": 80
  },
  "forbidden_operations": [
    "controller-reset",
    "firmware-download",
    "scan",
    "advertise",
    "pair",
    "connect",
    "acl-data",
    "radio-data"
  ],
  "contract": "display-bounded-local-hci-capabilities-and-wait-for-key"
}
