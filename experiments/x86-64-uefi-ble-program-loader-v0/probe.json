{
  "schema_version": 1,
  "probe_id": "x86-64-uefi-ble-program-loader-v0",
  "implementation_revision": 4,
  "target_usb_id": "0CF3:E009",
  "required_rom_version": "0x00000302",
  "rabbit_vm": {
    "version": 1,
    "frame_size_bytes": 16,
    "chunk_payload_bytes": 7,
    "transport_max_program_bytes": 224,
    "accepted_program_bytes": 24,
    "magic_ascii": "RP",
    "frame_types": {"1": "BEGIN", "2": "CHUNK", "3": "COMMIT"},
    "opcodes": {"1": "DEFINE_SHAPE", "2": "SET_POSITION", "255": "END"},
    "checksum": "fnv1a32-corruption-check-not-authentication",
    "transport": "ble-128-bit-service-uuid"
  },
  "display": {
    "initial_color": "yellow",
    "shape": "centered-128x128-square",
    "accepted_pixel_formats": ["PixelRedGreenBlueReserved8BitPerColor", "PixelBlueGreenRedReserved8BitPerColor"]
  },
  "operations": [
    "initialize-exact-qca-controller-ram-from-hash-pinned-inputs",
    "issue-one-post-load-hci-reset-and-wait-100ms",
    "bind-current-gop-framebuffer",
    "draw-initial-yellow-square",
    "configure-long-lived-passive-scan",
    "assemble-begin-chunk-commit-rabbit-vm-programs-in-ram",
    "validate-frame-and-program-checksums-version-opcodes-and-bounds",
    "atomically-activate-square-or-triangle-arrow-controlled-scene",
    "advertise-one-hash-bound-nonconnectable-ack-for-1500ms",
    "disable-ack-advertising-and-resume-passive-scan",
    "poll-local-escape-between-bounded-receives",
    "disable-passive-scan-on-local-exit"
  ],
  "limits": {
    "max_usb_interfaces_per_phase": 64,
    "startup_hci_commands": 5,
    "hci_commands_per_ack": 6,
    "ack_advertising_duration_ms": 1500,
    "max_command_events": 8,
    "event_timeout_ms": 200,
    "max_event_bytes": 80,
    "max_program_bytes": 224,
    "framebuffer_writes_per_draw": 16384,
    "runtime_duration": "until-local-escape-or-power-off"
  },
  "forbidden_operations": [
    "native-code-execution",
    "arbitrary-memory-write",
    "controller-flash-write",
    "active-scan",
    "arbitrary-advertise",
    "pair",
    "connect",
    "acl-data",
    "arbitrary-radio-transmit",
    "internal-storage-write",
    "firmware-setting-write"
  ],
  "contract": "one-boot-long-lived-transactional-wireless-program-loader-with-bounded-ack"
